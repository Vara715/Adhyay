# LLM configuration — points the agent's "brain" at an open-weight model.
# Works against any OpenAI-compatible /v1 endpoint: a local Ollama/vLLM/LM Studio/llama.cpp
# server, or a hosted open-weight inference provider (Groq, Together, Fireworks). Leave all
# blank to run the deterministic rule-based investigator instead (no LLM needed).
#
# Credentials can also be safely configured at runtime via the dashboard UI or POST /api/llm/config.
#
# LLM_PROVIDER selects a built-in default base URL: ollama | vllm | lmstudio | llamacpp |
# groq | together | fireworks. Set LLM_BASE_URL explicitly to override it or to point at any
# other OpenAI-compatible server.
#
# Example — local Ollama running an open-weight model:
#   LLM_PROVIDER=ollama
#   LLM_API_KEY=ollama            # Ollama ignores this; any non-empty value works
#   LLM_MODEL=llama3.1
#   (LLM_BASE_URL left blank — defaults to http://localhost:11434/v1)
#
# Example — Groq hosting an open-weight model:
#   LLM_PROVIDER=groq
#   LLM_API_KEY=<your groq api key>
#   LLM_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Backend configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173
